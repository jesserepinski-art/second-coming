[sub_resource type="Shader" id="Shader_8i38b"]
code = "shader_type canvas_item;

// wobble
uniform float wobble_speed = 1.5;
uniform float wobble_strength = 2.0;
uniform float opacity : hint_range(0.0, 1.0) = 1.0;
// eyelid
uniform float openness : hint_range(0.0, 1.0) = 0.0;
uniform float curve : hint_range(0.0, 1.0) = 0.4;
uniform float lid_line : hint_range(0.0, 1.0) = 0.5;
uniform bool pixel_snap = true;

uniform vec4 lid_color : source_color = vec4(0.12, 0.06, 0.06, 1.0);
uniform sampler2D lid_texture : source_color, filter_nearest;
uniform bool use_lid_texture = false;

uniform vec4 edge_color : source_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform float edge_width : hint_range(0.0, 0.1) = 0.03;

void vertex() {
	float wobble_x = sin(TIME * wobble_speed + VERTEX.y * 0.05) * wobble_strength;
	float wobble_y = cos(TIME * wobble_speed * 1.3 + VERTEX.x * 0.05) * wobble_strength * 0.5;
	VERTEX += vec2(wobble_x, wobble_y);
}

void fragment() {
	vec2 uv = UV;
	if (pixel_snap) {
		vec2 sz = vec2(textureSize(TEXTURE, 0));
		uv = (floor(UV * sz) + 0.5) / sz;
	}

	vec4 eye = texture(TEXTURE, UV);
	vec4 lid = use_lid_texture ? texture(lid_texture, UV) : lid_color;
	lid.a *= eye.a;

	float dx = (uv.x - 0.5) * 2.0;
	float max_half = max(lid_line, 1.0 - lid_line);

	float half_open = openness * (1.0 + curve) * max_half
			- curve * dx * dx * max_half * (1.0 - openness);

	float d = abs(uv.y - lid_line);
	float visible = step(d, half_open);
	float on_edge = (1.0 - visible) * step(d, half_open + edge_width) * step(0.0001, openness + half_open + 1.0);

	vec4 col = mix(lid, eye, visible);
	col = mix(col, vec4(edge_color.rgb, eye.a), on_edge * edge_color.a);
	COLOR = col;
	COLOR.a *= opacity;
}"

