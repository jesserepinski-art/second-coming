[sub_resource type="Resource" id="Resource_c8sum"]
script = ExtResource("25_fqorr")
speaker = ExtResource("26_rtpgk")
text = "excuse me?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_uaawx"]
script = ExtResource("25_fqorr")
speaker = ExtResource("27_qy4f1")
text = "Yes? How can I help you stranger?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_oo5qn"]
script = ExtResource("25_fqorr")
speaker = ExtResource("26_rtpgk")
text = "my ally, Providence, and I are searching for powerful people to help our cause"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_r344f"]
script = ExtResource("25_fqorr")
speaker = ExtResource("27_qy4f1")
text = "Which is?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_dd0ff"]
script = ExtResource("25_fqorr")
speaker = ExtResource("26_rtpgk")
text = "preventing the end of the world"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_uyc4f"]
script = ExtResource("25_fqorr")
speaker = ExtResource("27_qy4f1")
text = "Oh dear that is most dire, I thought the forest was being overdramatic..."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_1nwyu"]
script = ExtResource("25_fqorr")
speaker = ExtResource("26_rtpgk")
text = "what?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_cgpbv"]
script = ExtResource("25_fqorr")
speaker = ExtResource("27_qy4f1")
text = "The forest has accrued a blight within recent years that has only grown. At first, it wasn't bothered..."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_ji1mx"]
script = ExtResource("25_fqorr")
speaker = ExtResource("27_qy4f1")
text = "...but now, the heart cries out in pain. Assist me in clearing the blight and I will assist you."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_6ru8i"]
script = ExtResource("25_fqorr")
speaker = ExtResource("26_rtpgk")
text = "sounds like a plan man, lets go."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_3e5oy"]
script = ExtResource("28_rdoqh")
lines = Array[ExtResource("25_fqorr")]([SubResource("Resource_c8sum"), SubResource("Resource_uaawx"), SubResource("Resource_oo5qn"), SubResource("Resource_r344f"), SubResource("Resource_dd0ff"), SubResource("Resource_uyc4f"), SubResource("Resource_1nwyu"), SubResource("Resource_cgpbv"), SubResource("Resource_ji1mx"), SubResource("Resource_6ru8i")])
metadata/_custom_type_script = "uid://h5312gpyqv4w"

[sub_resource type="Resource" id="Resource_ej6um"]
script = ExtResource("25_fqorr")
text = "hey dude"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_pg7pd"]
script = ExtResource("25_fqorr")
speaker = ExtResource("27_qy4f1")
text = "..."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_yuame"]
script = ExtResource("25_fqorr")
speaker = ExtResource("26_rtpgk")
text = "(he's meditating)"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_or352"]
