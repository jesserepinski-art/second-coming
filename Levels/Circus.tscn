[sub_resource type="Resource" id="Resource_yx0gx"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("11_tspxo")
text = "I've returned with help my liege"
camera_target = "PartyFollower"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_n6c3u"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("12_mrm60")
text = "Ohoho! Providence, I told you to stop calling me that! Just call me The Clown!"
camera_target = "TheClown"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_pivgt"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("11_tspxo")
text = "I apologize."
camera_target = "PartyFollower"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_wxrie"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("12_mrm60")
text = "No need little one, now who do we have here?"
camera_target = "TheClown"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_o61yt"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("13_c5vg8")
text = "i'm dama"
camera_target = "Player"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_lmgep"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("11_tspxo")
text = "Ohohoho! So you're the one who Providence was rattling on about!"
camera_target = "TheClown"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_gwuhp"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("13_c5vg8")
text = "excuse me?"
camera_target = "Player"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_4ce3u"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("12_mrm60")
text = "Oh yes! They were quite obsessed with the thought of meeting someone who could take on God!"
camera_target = "TheClown"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_ck0uv"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("12_mrm60")
text = "After all, who wouldn't be excited to meet someone so amazing!"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_2woa0"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("13_c5vg8")
text = "i'm just a guy"
camera_target = "Player"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_2806a"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("12_mrm60")
text = "Oh Dama, we are all but humans, but that doesn't change our individuality!"
camera_target = "TheClown"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_6nfwo"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("13_c5vg8")
text = "(we?)"
camera_target = "Player"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_0a77w"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("13_c5vg8")
text = "yeah whatever, what did we need to come here for Providence?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_lsc46"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("11_tspxo")
text = "Oh yes! Clown, you mentioned several powerful people located around Patria..."
camera_target = "PartyFollower"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_1lcub"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("11_tspxo")
text = "...where may we find these individuals?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_oxvs2"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("12_mrm60")
text = "Ah yes. Seek out the village at the southern peninsula, the pink forest to the west, and the stone infection to the northwest."
camera_target = "TheClown"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_2jerc"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("12_mrm60")
text = "...there, you will find your allies."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_6v0iu"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("11_tspxo")
text = "We have our itinerary, let us depart Dama."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_nx30i"]
script = ExtResource("14_3iv0a")
lines = Array[ExtResource("10_jdl3y")]([SubResource("Resource_yx0gx"), SubResource("Resource_n6c3u"), SubResource("Resource_pivgt"), SubResource("Resource_wxrie"), SubResource("Resource_o61yt"), SubResource("Resource_lmgep"), SubResource("Resource_gwuhp"), SubResource("Resource_4ce3u"), SubResource("Resource_ck0uv"), SubResource("Resource_2woa0"), SubResource("Resource_2806a"), SubResource("Resource_6nfwo"), SubResource("Resource_0a77w"), SubResource("Resource_lsc46"), SubResource("Resource_1lcub"), SubResource("Resource_oxvs2"), SubResource("Resource_2jerc"), SubResource("Resource_6v0iu")])
metadata/_custom_type_script = "uid://h5312gpyqv4w"

[sub_resource type="Resource" id="Resource_faggk"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("12_mrm60")
text = "Welcome to the Circus little one..."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_1x45o"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("12_mrm60")
text = "Spread love and happiness... as that is all that is left..."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_hk5o6"]
script = ExtResource("14_3iv0a")
lines = Array[ExtResource("10_jdl3y")]([SubResource("Resource_faggk"), SubResource("Resource_1x45o")])
metadata/_custom_type_script = "uid://h5312gpyqv4w"

[sub_resource type="Resource" id="Resource_jiyv8"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("12_mrm60")
text = "Welcome back Dama, it is a pleasure to see you are doing well!"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_dmlpw"]
script = ExtResource("10_jdl3y")
speaker = ExtResource("13_c5vg8")
text = "hangin in there big guy, good to see you too."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_sv5a1"]
script = ExtResource("14_3iv0a")
lines = Array[ExtResource("10_jdl3y")]([SubResource("Resource_jiyv8"), SubResource("Resource_dmlpw")])
metadata/_custom_type_script = "uid://h5312gpyqv4w"

