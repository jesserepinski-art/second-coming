[sub_resource type="Resource" id="Resource_g3or5"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("16_6fl11")
text = "Oh hello! Welcome to our little village! I hope you have a good time here!"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_upieb"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("17_q06sx")
text = "Actually, we were looking for someone. Named Aceso?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_ma0f3"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("16_6fl11")
text = "You're talking to her! How can I help y'all?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_xb3cj"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("17_q06sx")
text = "We're recruiting powerful people for our cause. Your healing abilities have been heard of around Patria, will you help us?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_6l4vu"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("16_6fl11")
text = "I'm flattered... but I have a lot on my plate right now. I was about to go to the mountain to the northeast in search of a tome."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_64goi"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("16_6fl11")
text = "but may I ask, what is your cause anyway?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_s5ix7"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("17_q06sx")
text = "the world is going to end soon and we need to stop God"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_y804m"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("16_6fl11")
text = "Are you crazy?! How could we ever stand against the father?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_piacm"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("17_q06sx")
text = "it's us or him. I made a promise and will be going after him regardless. we could use your help Aceso."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_a3tgu"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("16_6fl11")
text = "...hmmm... "
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_b44ec"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("16_6fl11")
text = "Help me find this tome and I will join your cause, I have something I need to save too."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_kox4g"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("17_q06sx")
text = "To the mountain we go."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_svu2g"]
script = ExtResource("18_k7bhe")
lines = Array[ExtResource("15_r2kfc")]([SubResource("Resource_g3or5"), SubResource("Resource_upieb"), SubResource("Resource_ma0f3"), SubResource("Resource_xb3cj"), SubResource("Resource_6l4vu"), SubResource("Resource_64goi"), SubResource("Resource_s5ix7"), SubResource("Resource_y804m"), SubResource("Resource_piacm"), SubResource("Resource_a3tgu"), SubResource("Resource_b44ec"), SubResource("Resource_kox4g")])
metadata/_custom_type_script = "uid://h5312gpyqv4w"

[sub_resource type="Resource" id="Resource_l1vel"]
