speaker = ExtResource("16_6fl11")
text = "Hello! Welcome to our little village! I hope you have a good time!"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_6cgkl"]
script = ExtResource("15_r2kfc")
speaker = ExtResource("17_q06sx")
text = "thanks"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

