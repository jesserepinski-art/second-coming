[sub_resource type="Resource" id="Resource_3e5oy"]
script = ExtResource("9_bld17")
lines = Array[String](["I heard if you run around this statue a ton you might see a ghost! ", "I don't believe in them, that's why I'm doing this."])
metadata/_custom_type_script = "uid://c3vvxxn2ad01k"

[sub_resource type="Resource" id="Resource_7ej5t"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("32_smo4t")
text = "Please... I don't know where she went..."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_d566u"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("33_4hl7p")
text = "Thou want to calm down... Now, start at the beginning."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_eb8id"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("32_smo4t")
text = "My daughter... she kept saying she wanted to play in the forest, that her \"friend\" was there..."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_lbopm"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("32_smo4t")
text = "...but there is no forest around, besides the one up north... She was just in her bed, I didn't even hear anyone leave."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_3wdhe"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("33_4hl7p")
text = "Don't worry miss, I shall search around. I was just about to hie up there."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_ql3ew"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("32_smo4t")
text = "Oh my... you are a savior, I'll keep looking around... Oh God where could she be..."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_cwjpm"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("33_4hl7p")
text = "Ah Dama, just 'i time. We must go north to help this woman."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_30vm2"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("34_l2fmb")
text = "I didn't agree to this, we're supposed to be goin-"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_5d67c"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("33_4hl7p")
text = "Oh Dama, it's nought yet a side quest. It'll be good for thy heart and bones."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_wwmiw"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("34_l2fmb")
text = "You know nothing about my heart OR my bones..."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_hg5rn"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("33_4hl7p")
text = "I wot what thou desire. And yet, the joy of others shall be prioritzed on our journey. For that is our intent."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_wyjm8"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("34_l2fmb")
text = "YOUR intent. Fine, we'll make a pitstop."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_u7dto"]
script = ExtResource("31_8ywqh")
speaker = ExtResource("33_4hl7p")
text = "Allow us to begin, mine new friend."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_j832m"]
script = ExtResource("35_lqt4s")
lines = Array[ExtResource("31_8ywqh")]([SubResource("Resource_7ej5t"), SubResource("Resource_d566u"), SubResource("Resource_eb8id"), SubResource("Resource_lbopm"), SubResource("Resource_3wdhe"), SubResource("Resource_ql3ew"), SubResource("Resource_cwjpm"), SubResource("Resource_30vm2"), SubResource("Resource_5d67c"), SubResource("Resource_wwmiw"), SubResource("Resource_hg5rn"), SubResource("Resource_wyjm8"), SubResource("Resource_u7dto")])
metadata/_custom_type_script = "uid://h5312gpyqv4w"

