[sub_resource type="Resource" id="Resource_oyyh7"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "You don't need to worry anymore, you're safe now."
camera_target = "DreamChild"
camera_zoom = 1.0
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_86ga8"]
script = ExtResource("18_rwkar")
speaker = ExtResource("20_k3kix")
text = "i miss my mommy... when can i go back?"
camera_target = "PotDaughter"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_egved"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "There's no need to go back now, it's safer here, we don't have to worry here."
camera_target = "DreamChild"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_na7ei"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "Hey dipshit."
camera_target = "Player"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_l6g2i"]
script = ExtResource("18_rwkar")
speaker = ExtResource("22_0soxv")
text = "Dama, there is a child right there, could you have some decency?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_bheo1"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "...."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_p66yg"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "Hey... butthead..."
camera_target = "WideShot"
camera_zoom = 0.5
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_dinob"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "A mother is looking for her daughter, said she went to the forest for her friend. "
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_0pp1f"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "You know anything? Kinda looks like you do."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_u1kyp"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "You come at me with agression when I have done nothing but shelter this child."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_uf683"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "You kidnapped them dude. "
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_fdund"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "I SAVED them from the end that is coming soon."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_m2fgb"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "Doesn't a child deserve at least some peace within this world?"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_fmhp5"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "Well, yeah of course but you can't just take 'em out of bed. That's weird. "
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_65ppb"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "Enough, you couldn't understand as an adult. Prepare to join the haze."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_c8sum"]
script = ExtResource("23_3anie")
lines = Array[ExtResource("18_rwkar")]([SubResource("Resource_oyyh7"), SubResource("Resource_86ga8"), SubResource("Resource_egved"), SubResource("Resource_na7ei"), SubResource("Resource_l6g2i"), SubResource("Resource_bheo1"), SubResource("Resource_p66yg"), SubResource("Resource_dinob"), SubResource("Resource_0pp1f"), SubResource("Resource_u1kyp"), SubResource("Resource_uf683"), SubResource("Resource_fdund"), SubResource("Resource_m2fgb"), SubResource("Resource_fmhp5"), SubResource("Resource_65ppb")])
metadata/_custom_type_script = "uid://h5312gpyqv4w"

[sub_resource type="Resource" id="Resource_v8dhg"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "Why are you so adamant on causing this child more suffering?"
camera_target = "DreamChild"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_3it10"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "you're one to talk. girl has been crying the whole time"
camera_target = "WideShot"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_lpkxx"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "It's hard to leave something you've always known, but here... it's safe for her"
camera_target = "WideShot"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_jsr3m"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "you're tripping. this is a forest man. it might smell like cotton candy but it's still a forest"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_jkka6"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "So she deserves to experience the torment that is out there? "
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_4usn4"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "she deserves to be able to make her own choice. she can always come back."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_x3g4g"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "The connection we have will be gone, the world will do her in. She doesn't need to know any of that cruelty."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_btb6e"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "she misses her mother and her mother misses her. the world might do her in, or she might overcome it."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_ip1wh"]
script = ExtResource("18_rwkar")
speaker = ExtResource("21_dicvn")
text = "the world is cruel but she might make something out of it. give her a chance."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_x0fnm"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "If it was my choice, I wouldn't allow it... but... I don't have a choice."
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_wn4qh"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "Maybe another time..."
camera_target = "DreamChild"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_26txx"]
script = ExtResource("18_rwkar")
speaker = ExtResource("20_k3kix")
text = "We can play tomorrow!"
camera_target = "PotDaughter"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

[sub_resource type="Resource" id="Resource_85o21"]
script = ExtResource("18_rwkar")
speaker = ExtResource("19_h2jan")
text = "That'd be nice, Maple"
camera_target = "Dream Child"
metadata/_custom_type_script = "uid://dyh6g1lditqd7"

